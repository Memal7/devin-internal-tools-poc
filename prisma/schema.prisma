// Portable schema: keep it compatible with PostgreSQL (no SQLite-only features).
// Enum-like columns are plain strings validated with Zod in the platform layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  roles     UserRole[]

  @@map("users")
}

model UserRole {
  userId String
  role   String // viewer | operator | approver | admin
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

// Append-only. There must never be an update or delete code path for this table.
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String? // null for system actions (e.g. seed)
  actorEmail String
  action     String
  entityType String
  entityId   String
  before     String? // JSON snapshot
  after      String? // JSON snapshot
  metadata   String? // JSON, never contains PII values
  createdAt  DateTime @default(now()) // UTC

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorEmail])
  @@index([action])
  @@map("audit_events")
}

model ApprovalRequest {
  id             String    @id @default(cuid())
  ruleKey        String
  entityType     String
  entityId       String
  summary        String
  amountMinor    Int? // money in integer minor units
  currency       String? // ISO 4217
  payload        String // JSON
  status         String    @default("pending") // pending | approved | declined
  requesterId    String
  requesterEmail String
  deciderId      String?
  deciderEmail   String?
  decisionReason String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([entityType, entityId])
  @@map("approval_requests")
}

// --- Refunds app (src/apps/refunds) ---

model Payment {
  id            String   @id @default(cuid())
  reference     String   @unique // human-readable, e.g. PAY-000123
  customerName  String // PII: masked by default
  amountMinor   Int // money in integer minor units
  currency      String // ISO 4217
  status        String // succeeded | pending | failed
  // Sum of refunds that are requested, auto_approved or approved. Updated atomically so
  // total refunds can never exceed amountMinor.
  refundedMinor Int      @default(0)
  createdAt     DateTime @default(now()) // UTC
  updatedAt     DateTime @updatedAt
  refunds       Refund[]

  @@index([createdAt])
  @@index([status])
  @@map("payments")
}

model Refund {
  id               String    @id @default(cuid())
  paymentId        String
  payment          Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amountMinor      Int // money in integer minor units
  currency         String // ISO 4217, always the payment's currency
  reason           String
  status           String // requested | auto_approved | approved | declined
  requestedById    String
  requestedByEmail String
  decidedById      String?
  decidedByEmail   String?
  decisionReason   String?
  decidedAt        DateTime? // UTC
  createdAt        DateTime  @default(now()) // UTC, when the refund was requested
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([amountMinor])
  @@index([paymentId])
  @@map("refunds")
}

// --- KYC Review Queue app (src/apps/kyc) ---

model KycCase {
  id                   String   @id @default(cuid())
  reference            String   @unique // human-readable, e.g. KYC-000123
  customerName         String // PII: masked by default
  dateOfBirth          String // PII: calendar date YYYY-MM-DD (no time zone), masked by default
  documentType         String // passport | national_id | driving_licence
  documentNumber       String // PII: masked by default
  country              String // ISO 3166-1 alpha-2
  riskScore            Int // 0-100; >= 70 needs a second approver to approve
  status               String   @default("pending") // pending | in_review | approved | rejected | escalated
  assignedAnalystId    String?
  assignedAnalystEmail String?
  // Platform approval request awaiting a second person (high-risk approve). Locks the case while pending.
  approvalRequestId    String?
  decisionReason       String? // required when approved, rejected or escalated
  createdAt            DateTime @default(now()) // UTC
  updatedAt            DateTime @updatedAt // UTC

  @@index([status, createdAt])
  @@index([riskScore])
  @@index([createdAt])
  @@index([assignedAnalystId])
  @@map("kyc_cases")
}
