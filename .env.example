# Copy to .env (npm run setup does this for you). Dummy values only: never commit real secrets.

# --- Database ---
# SQLite for local development. Path is relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- Auth.js core ---
# Random secret used to sign session tokens. npm run setup replaces the
# placeholder below with a random value in your local .env.
AUTH_SECRET="replace-me-with-a-random-secret"
# Base URL of the app (required behind proxies / in production).
AUTH_URL="http://localhost:3000"
# Set to "true" only when running behind a trusted reverse proxy.
AUTH_TRUST_HOST="true"

# --- Dev login (seeded demo users) ---
# Shows the demo user picker at /login. Ignored when NODE_ENV=production.
AUTH_DEV_LOGIN_ENABLED="true"

# --- OIDC single sign-on (disabled by default) ---
# One of: none | entra | okta
AUTH_OIDC_PROVIDER="none"

# Microsoft Entra ID (used when AUTH_OIDC_PROVIDER="entra")
AUTH_MICROSOFT_ENTRA_ID_ID="00000000-0000-0000-0000-000000000000"
AUTH_MICROSOFT_ENTRA_ID_SECRET="dummy-entra-client-secret"
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0"

# Okta (used when AUTH_OIDC_PROVIDER="okta")
AUTH_OKTA_ID="dummy-okta-client-id"
AUTH_OKTA_SECRET="dummy-okta-client-secret"
# https://<your-org>.okta.com/oauth2/default
AUTH_OKTA_ISSUER="https://example.okta.com/oauth2/default"
